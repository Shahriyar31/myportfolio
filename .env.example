# Copy to .env (never commit .env). Set the same variables in Vercel → Project → Settings → Environment Variables.

# Required for "Ask my AI" and "Break my AI" (free key: https://console.groq.com/keys)
GROQ_API_KEY=

# Optional: override the models (defaults shown)
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_FAST_MODEL=llama-3.1-8b-instant

# Optional: shared rate limits and counters across serverless instances (Upstash Redis / Vercel KV)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional: contact letters via Resend (otherwise FormSubmit is used)
# RESEND_API_KEY=
# CONTACT_TO=
# CONTACT_FROM=
